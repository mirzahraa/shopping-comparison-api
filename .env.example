# Environment Configuration

# API Keys for E-commerce Platforms
AMAZON_API_KEY=your_amazon_api_key
FLIPKART_API_KEY=your_flipkart_api_key
MYNTRA_API_KEY=your_myntra_api_key
REDTAPE_API_KEY=your_redtape_api_key
VMART_API_KEY=your_vmart_api_key

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/shopping_comparison_db
MONGODB_URL=mongodb://localhost:27017/shopping_comparison

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
SECRET_KEY=your_secret_key_here

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Scraping Configuration
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_TIMEOUT=30
MAX_RETRIES=3
RATE_LIMIT_DELAY=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Cache Configuration
CACHE_TTL=3600
PRICE_UPDATE_INTERVAL=3600
